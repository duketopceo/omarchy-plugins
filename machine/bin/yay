#!/usr/bin/env bash
# yay guard: refuse --sudoloop when there is no terminal.
#
# yay's --sudoloop re-runs `sudo -v` every couple of seconds to keep sudo
# alive. Without a terminal each attempt is a failed login, and faillock is
# shared with the lock screen: on 2026-10-31 a forgotten loop kept the
# account locked out for about five hours. Everything else passes through.
REAL=/usr/bin/yay

if [[ ! -t 0 ]]; then
  for arg in "$@"; do
    if [[ $arg == --sudoloop ]]; then
      echo "yay guard: refusing --sudoloop without a terminal (it would trip faillock, which also locks the screen). Run it in a terminal, or drop --sudoloop." >&2
      exit 2
    fi
  done
fi
exec "$REAL" "$@"
