{
  "_meta": {
    "updated": "2026-10-03",
    "source": "sanitized live shell state",
    "note": "Runtime counters, credentials, and host paths are intentionally omitted."
  },
  "idle": {
    "lock": 600,
    "screensaver": 480
  },
  "disabledPlugins": [
    "omarchy.clock",
    "omarchy.tray",
    "omarchy.monitor",
    "omarchy.keyboard-layout",
    "omarchy.audio"
  ],
  "bar": {
    "centerAnchor": "tmn73.calendar",
    "layout": {
      "center": [
        {
          "id": "omarchy.media",
          "maxLabelWidth": 140
        },
        {
          "id": "omarchy.indicators"
        },
        {
          "id": "mohamedmansour.finance",
          "showChange": false,
          "showLastUpdated": true
        },
        {
          "format": "dddd h:mm AP",
          "formatAlt": "d MMMM 'W'ww yyyy",
          "id": "tmn73.calendar",
          "verticalFormat": "h\n—\nmm\nAP"
        },
        {
          "id": "omarchy.weather",
          "unit": "imperial"
        },
        {
          "id": "io.github.duketopceo.wisp"
        },
        {
          "id": "omarchy.system-update"
        }
      ],
      "left": [
        {
          "id": "omarchy.menu"
        },
        {
          "id": "omarchy.workspaces"
        },
        {
          "id": "omaplug"
        },
        {
          "id": "io.github.twiking.omasettings"
        },
        {
          "id": "omarchy.active-window"
        }
      ],
      "right": [
        {
          "id": "io.github.tyrichards.tray",
          "order": [
            "1Password_status_icon_1",
            "fastpotify",
            "jankeesvw.herdr",
            "lukedaduke.nexus",
            "NordVPN"
          ],
          "widgets": [
            {
              "entry": {
                "id": "jankeesvw.herdr"
              },
              "listed": true
            },
            {
              "entry": {
                "id": "lukedaduke.nexus"
              },
              "listed": true
            }
          ]
        },
        {
          "id": "hancore.voxtype-enhance"
        },
        {
          "id": "nixfred.blip"
        },
        {
          "id": "omarchy.tailscale"
        },
        {
          "id": "omarchy.bluetooth"
        },
        {
          "id": "omarchy.network"
        },
        {
          "id": "akitaonrails.ai-usagebar"
        },
        {
          "captureNotifications": false,
          "id": "ssupt.audio-control"
        },
        {
          "id": "crmne.hyprmoncfg"
        },
        {
          "id": "lukedaduke.power",
          "showPercentage": true
        },
        {
          "id": "io.github.ncr.omaphones",
          "useFastPair": false,
          "useModeControl": false
