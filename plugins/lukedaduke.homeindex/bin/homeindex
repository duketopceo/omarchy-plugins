#!/usr/bin/env python3
"""Home Index helper: open INDEX.md / lanes, run home-index-audit.

Usage:
  homeindex open            # open ~/INDEX.md in editor
  homeindex open <lane>     # open Work|duke|agents|shots lane folder
  homeindex audit           # run home-index-audit (notify summary)
  homeindex rebuild         # run home-index repo indexer if present
"""
from __future__ import annotations

import subprocess
import sys
from pathlib import Path

HOME = Path.home()


def find_lanes() -> dict[str, Path]:
    """Auto-detect lanes from the local layout (no hardcoded names)."""
    lanes: dict[str, Path] = {}
    for label, tail in (("work", HOME / "Work"), ("projects", HOME / "Projects")):
        if tail.is_dir():
            for child in sorted(tail.iterdir()):
                if child.is_dir() and not child.name.startswith("."):
                    lanes[label] = child
                    break
    for label, path in (
        ("agents", HOME / "Agents"),
        ("shots", HOME / "Pictures" / "Screenshots"),
    ):
        if path.exists():
            lanes[label] = path
    return lanes


def notify(title: str, body: str) -> None:
    subprocess.run(["notify-send", title, body], check=False)


def main() -> int:
    if len(sys.argv) < 2:
        print(__doc__)
        return 2
    cmd = sys.argv[1]
    if cmd == "open" and len(sys.argv) == 2:
        path = HOME / "INDEX.md"
        subprocess.run(["xdg-open", str(path)], check=False)
        return 0
    if cmd == "open" and len(sys.argv) == 3:
        lanes = find_lanes()
        lane = lanes.get(sys.argv[2])
        if lane is None:
            print(f"Unknown lane {sys.argv[2]!r}. Lanes: {', '.join(lanes)}")
            return 2
        if not lane.exists():
            print(f"Lane missing: {lane}")
            return 1
        subprocess.run(["xdg-open", str(lane)], check=False)
        return 0
    if cmd == "audit":
        result = subprocess.run(
            ["home-index-audit"], capture_output=True, text=True, timeout=120
        )
        summary = (result.stdout + result.stderr).strip().splitlines()
        last = summary[-1] if summary else "audit produced no output"
        notify("Home Index audit", last[:200])
        print(last)
        return result.returncode
    if cmd == "rebuild":
        indexer = None
        projects = HOME / "Projects"
        if projects.is_dir():
            for candidate in sorted(projects.glob("*/home-index/index.py")):
                if candidate.is_file():
                    indexer = candidate
                    break
        if installer is None:
            print("No indexer found under ~/Projects/*/home-index/index.py")
            return 1
        result = subprocess.run(["python3", str(indexer)], capture_output=True, text=True, timeout=300)
        notify("Home Index rebuild", (result.stdout.strip().splitlines() or ["done"])[-1][:200])
        print(result.stdout)
        return result.returncode
    print(__doc__)
    return 2


if __name__ == "__main__":
    raise SystemExit(main())
