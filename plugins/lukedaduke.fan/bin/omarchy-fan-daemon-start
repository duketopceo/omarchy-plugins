#!/bin/bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd -P)"
PLUGIN_DIR="$(cd "$SCRIPT_DIR/.." && pwd -P)"
SERVICE_SRC="$PLUGIN_DIR/omarchy-fan-daemon.service"
SERVICE_DST="/etc/systemd/system/omarchy-fan-daemon.service"
SYSTEMCTL="/usr/bin/systemctl"
PKEXEC="/usr/bin/pkexec"

if [ ! -f "$SERVICE_SRC" ]; then
    echo "fan service definition is missing: $SERVICE_SRC" >&2
    exit 1
fi
case "$PLUGIN_DIR" in
    *'&'*|*'|'*|*'\'*)
        echo "plugin path cannot be represented safely in the service unit" >&2
        exit 1
        ;;
esac

CALLER_UID=""
if [ "${1:-}" = "--caller-uid" ]; then
    CALLER_UID="${2:-}"
    shift 2
fi

if [ "$(id -u)" -ne 0 ]; then
    if [ ! -x "$PKEXEC" ]; then
        echo "fan control requires the system authorization helper" >&2
        exit 1
    fi
    exec "$PKEXEC" "$0" --caller-uid "$(id -u)"
fi

TARGET_UID="$CALLER_UID"
if [ -z "$TARGET_UID" ]; then
    TARGET_UID="${OMARCHY_FAN_UID:-}"
fi
if [ -z "$TARGET_UID" ]; then
    TARGET_UID="$(/usr/bin/find /run/user -mindepth 1 -maxdepth 1 -type d -printf '%f\n' 2>/dev/null | /usr/bin/awk '$1 >= 1000 { print $1; exit }')"
fi
if ! [[ "$TARGET_UID" =~ ^[0-9]+$ ]] || [ "$TARGET_UID" -lt 1 ]; then
    echo "unable to determine the desktop user for fan control" >&2
    exit 1
fi

if [ ! -x "$SYSTEMCTL" ]; then
    echo "systemd is required for the approved fan helper" >&2
    exit 1
fi

TMP_SERVICE="/etc/systemd/system/.omarchy-fan-daemon.service.$$"
trap 'rm -f "$TMP_SERVICE"' EXIT
sed \
    -e "s|ExecStart=.*|ExecStart=$PLUGIN_DIR/bin/omarchy-fan-daemon --uid $TARGET_UID|" \
    -e "s|OMARCHY_FAN_UID=[0-9]*|OMARCHY_FAN_UID=$TARGET_UID|g" \
    "$SERVICE_SRC" >"$TMP_SERVICE"
/usr/bin/install -o root -g root -m 0644 "$TMP_SERVICE" "$SERVICE_DST"
"$SYSTEMCTL" daemon-reload
if ! "$SYSTEMCTL" is-enabled -q omarchy-fan-daemon.service 2>/dev/null; then
    "$SYSTEMCTL" enable omarchy-fan-daemon.service
fi
"$SYSTEMCTL" restart omarchy-fan-daemon.service
