[Unit]
Description=Omarchy Fan Daemon for lukedaduke.fan
After=multi-user.target

[Service]
Type=simple
# ExecStart is a placeholder: omarchy-fan-daemon-start rewrites it to the
# plugin's installed path with --uid <desktop user> at install time.
ExecStart=/usr/bin/omarchy-fan-daemon
Restart=on-failure
RestartSec=5
Environment="OMARCHY_FAN_UID=1000"

[Install]
WantedBy=multi-user.target
