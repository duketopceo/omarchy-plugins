[Unit]
# Requires net.netfilter.nf_conntrack_acct=1; see README. Without it every
# flow reports zero bytes and the collector silently stores nothing.
Description=netline packet/flow lineage tracker (passive capture, SQLite store)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
Group=root
# /proc/net/nf_conntrack is root-only (IP_NF_CONNTRACK_FILE permissions), so
# the poller must run privileged. Raw AF_PACKET needs it too for SNI/DNS.
NoNewPrivileges=yes
# The collector runs as root, so it cannot use %h (that resolves to /root).
# The install step writes the operator's state directory here:
#   sudo install -d /etc/netline
#   echo 'NETLINE_STATE=<your-home>/.local/share/netline' \
#     | sudo tee /etc/netline/netline.env
EnvironmentFile=/etc/netline/netline.env
Environment=NETLINE_PLUGIN=%d
ExecStart=/usr/bin/python3 ${NETLINE_STATE}/netline.py daemon
Restart=always
RestartSec=3
# Capture buffer is preallocated; keep the daemon modest and predictable.
Nice=5
IOSchedulingClass=best-effort
IOSchedulingPriority=7

[Install]
WantedBy=multi-user.target
