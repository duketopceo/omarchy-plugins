#!/usr/bin/python3
"""Fetch weather and sunrise/sunset for the lukedaduke.standby overlay.

Uses Open-Meteo (https://open-meteo.com) for current conditions, today's
high/low, and sunrise/sunset times. Location is read from
~/.local/state/omarchy/settings/weather.json; if that is missing or incomplete,
an IP geolocation service is used as a fallback.
"""

import json
import math
import os
import signal
import stat
import time
import urllib.error
import urllib.parse
import urllib.request
from pathlib import Path

MAX_RESPONSE_BYTES = 1024 * 1024  # 1 MiB per remote response
JOB_DEADLINE_S = 18  # whole-job wall clock, under the QML-side 20s deadline

HOME = Path.home()
LOC_FILE = HOME / ".local/state/omarchy/settings/weather.json"
CACHE_FILE = HOME / ".cache/omarchy/standby-weather.json"
LOC_MAX_BYTES = 16 * 1024
CACHE_MAX_BYTES = 64 * 1024
CACHE_TTL_S = 30 * 60  # stale cache stops standing in for live data
CACHE_CLOCK_SKEW_S = 60  # tolerate a fetched_at slightly in the future


def _open_dir(path):
    """Descriptor for a directory — no symlinks, must be ours."""
    fd = os.open(path, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW)
    st = os.fstat(fd)
    if not stat.S_ISDIR(st.st_mode) or st.st_uid != os.geteuid():
        os.close(fd)
        raise PermissionError(f"{path} is not a user-owned real directory")
    return fd


def _read_capped(dirfd, name, limit):
    """Bounded, no-follow, regular-file read; None on any anomaly."""
    try:
        fd = os.open(name, os.O_RDONLY | os.O_NOFOLLOW, dir_fd=dirfd)
    except OSError:
        return None
    try:
        st = os.fstat(fd)
        if not stat.S_ISREG(st.st_mode) or st.st_uid != os.geteuid() or st.st_size > limit:
            return None
        return os.read(fd, limit)
    finally:
        os.close(fd)


def _publish(dirfd, name, data):
    """Write via exclusive same-dir temp file + atomic rename."""
    tmp = f".{name}.{os.getpid()}.tmp"
    fd = os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW, 0o600, dir_fd=dirfd)
    try:
        os.write(fd, data.encode())
        os.fsync(fd)
    finally:
        os.close(fd)
    os.rename(tmp, name, src_dir_fd=dirfd, dst_dir_fd=dirfd)

WMO_DESCRIPTIONS = {
    0: "Clear sky",
    1: "Mainly clear",
    2: "Partly cloudy",
    3: "Overcast",
    45: "Fog",
    48: "Depositing rime fog",
    51: "Light drizzle",
    53: "Moderate drizzle",
    55: "Dense drizzle",
    56: "Light freezing drizzle",
    57: "Dense freezing drizzle",
    61: "Slight rain",
    63: "Moderate rain",
    65: "Heavy rain",
    66: "Light freezing rain",
    67: "Heavy freezing rain",
    71: "Slight snow fall",
    73: "Moderate snow fall",
    75: "Heavy snow fall",
    77: "Snow grains",
    80: "Slight rain showers",
    81: "Moderate rain showers",
    82: "Violent rain showers",
    85: "Slight snow showers",
    86: "Heavy snow showers",
    95: "Thunderstorm",
    96: "Thunderstorm with slight hail",
    99: "Thunderstorm with heavy hail",
}


def iso_to_hm(iso: str) -> str:
    if not iso:
        return ""
    try:
        return iso.split("T")[1][:5]
    except Exception:
        return ""


def _num(value):
    """Finite real number or None — strings/dicts/bools/inf/nan degrade."""
    if not isinstance(value, (int, float)) or isinstance(value, bool):
        return None
    if not math.isfinite(value) or abs(value) > 1e6:
        return None
    return value


def _first(value):
    """First element of a non-empty list/tuple; None for anything else."""
    if isinstance(value, (list, tuple)) and value:
        return value[0]
    return None


def load_weather_location():
    try:
        dirfd = _open_dir(LOC_FILE.parent)
    except (OSError, PermissionError):
        return None, None, ""
    try:
        raw = _read_capped(dirfd, LOC_FILE.name, LOC_MAX_BYTES)
    finally:
        os.close(dirfd)
    if raw is None:
        return None, None, ""
    try:
        data = json.loads(raw)
        if not isinstance(data, dict):
            return None, None, ""
        lat = data.get("latitude")
        lon = data.get("longitude")
        name = str(data.get("name") or "")[:60]
        if lat is not None and lon is not None:
            return float(lat), float(lon), name
        if name:
            return None, None, name
    except (OSError, ValueError, TypeError, OverflowError):
        # float() raises TypeError on dict/list members and OverflowError on
        # huge ints — malformed settings must degrade, not crash.
        pass
    return None, None, ""


class HTTPSOnlyRedirectHandler(urllib.request.HTTPRedirectHandler):
    """Follow redirects only when the destination is also HTTPS."""

    def redirect_request(self, req, fp, code, msg, headers, newurl):
        if urllib.parse.urlparse(newurl).scheme != "https":
            raise urllib.error.URLError(f"refused to follow non-HTTPS redirect to {newurl}")
        return super().redirect_request(req, fp, code, msg, headers, newurl)


FETCH_OPENER = urllib.request.build_opener(HTTPSOnlyRedirectHandler)


def fetch_json(url: str, timeout: int = 10):
    if urllib.parse.urlparse(url).scheme != "https":
        raise urllib.error.URLError(f"refused non-HTTPS URL: {url}")

    req = urllib.request.Request(url, headers={"User-Agent": "lukedaduke.standby/1.0"})
    with FETCH_OPENER.open(req, timeout=timeout) as resp:
        cl = resp.headers.get("Content-Length")
        if cl is not None and int(cl) > MAX_RESPONSE_BYTES:
            raise ValueError(f"Content-Length {cl} exceeds byte budget")
        content_type = resp.headers.get("Content-Type", "").split(";", 1)[0].strip().lower()
        if content_type and content_type not in {"application/json", "application/x-json", "text/json"}:
            raise ValueError(f"unexpected response type {content_type}")
        data = resp.read(MAX_RESPONSE_BYTES + 1)
        if len(data) > MAX_RESPONSE_BYTES:
            raise ValueError("response body exceeded byte budget")
        return json.loads(data.decode("utf-8"))


def get_ip_location():
    # HTTPS only; the previous HTTP fallback has been removed to avoid downgrade.
    for url in ("https://ipapi.co/json/",):
        try:
            data = fetch_json(url, timeout=5)
            lat = data.get("latitude") if "latitude" in data else data.get("lat")
            lon = data.get("longitude") if "longitude" in data else data.get("lon")
            name = str(data.get("city", ""))[:60]
            if lat is None or lon is None:
                continue
            return float(lat), float(lon), name
        except Exception:
            continue
    return None, None, ""


def write_cache(payload):
    try:
        CACHE_FILE.parent.mkdir(parents=True, exist_ok=True)
        dirfd = _open_dir(CACHE_FILE.parent)
    except (OSError, PermissionError):
        return
    try:
        _publish(dirfd, CACHE_FILE.name,
                 json.dumps({"fetched_at": time.time(), "data": payload}))
    except OSError:
        pass
    finally:
        os.close(dirfd)


def read_cache(now=None):
    """Re-emit a fresh, well-formed cached payload; None otherwise.

    The cache is an envelope {"fetched_at": epoch, "data": {...}} — it must
    actually parse (a truncated file starting with "{" is not valid), carry a
    sane timestamp, and be younger than CACHE_TTL_S so a persistent outage
    surfaces an error instead of arbitrarily stale weather.
    """
    try:
        dirfd = _open_dir(CACHE_FILE.parent)
    except (OSError, PermissionError):
        return None
    try:
        raw = _read_capped(dirfd, CACHE_FILE.name, CACHE_MAX_BYTES)
    finally:
        os.close(dirfd)
    if raw is None:
        return None
    try:
        obj = json.loads(raw)
    except (UnicodeDecodeError, ValueError):
        return None
    if not isinstance(obj, dict):
        return None
    fetched_at = obj.get("fetched_at")
    data = obj.get("data")
    if not isinstance(fetched_at, (int, float)) or isinstance(fetched_at, bool):
        return None
    if not isinstance(data, dict):
        return None
    age = (time.time() if now is None else now) - fetched_at
    if age < -CACHE_CLOCK_SKEW_S or age > CACHE_TTL_S:
        return None
    return json.dumps(data)


def main():
    # Backstop deadline even if the caller never reaps us.
    signal.signal(signal.SIGALRM, lambda *_: os._exit(124))
    signal.alarm(JOB_DEADLINE_S)

    lat, lon, name = load_weather_location()
    if lat is None or lon is None:
        lat, lon, name = get_ip_location()

    if lat is None or lon is None:
        cached = read_cache()
        if cached:
            print(cached)
            return
        print(json.dumps({"error": "unable to determine location"}))
        return

    url = (
        "https://api.open-meteo.com/v1/forecast"
        f"?latitude={lat}&longitude={lon}"
        "&current=temperature_2m,relative_humidity_2m,apparent_temperature,weather_code,wind_speed_10m,is_day"
        "&daily=weather_code,temperature_2m_max,temperature_2m_min,sunrise,sunset"
        "&timezone=auto&forecast_days=1"
    )

    try:
        data = fetch_json(url, timeout=10)
    except Exception as exc:
        cached = read_cache()
        if cached:
            print(cached)
            return
        print(json.dumps({"error": f"weather fetch failed: {exc}"}))
        return

    try:
        result = build_result(data, name)
    except Exception:
        # Remote returned a valid-JSON body in an unexpected shape — fall back
        # to cache rather than crash on AttributeError/KeyError/TypeError.
        cached = read_cache()
        if cached:
            print(cached)
            return
        print(json.dumps({"error": "malformed weather payload"}))
        return

    write_cache(result)
    print(json.dumps(result))


def build_result(data, name):
    """Shape-validate the Open-Meteo response and build the panel payload."""
    if not isinstance(data, dict):
        raise TypeError("weather payload is not an object")
    current = data.get("current") or {}
    daily = data.get("daily") or {}
    units = data.get("current_units") or {}
    if not (isinstance(current, dict) and isinstance(daily, dict)
            and isinstance(units, dict)):
        raise TypeError("weather payload sections are not objects")
    temp_unit = units.get("temperature_2m")
    wind_unit = units.get("wind_speed_10m")
    if not isinstance(temp_unit, str):
        temp_unit = "°C"
    if not isinstance(wind_unit, str):
        wind_unit = "km/h"

    code = current.get("weather_code")
    description = (
        WMO_DESCRIPTIONS.get(code, "Unknown")
        if isinstance(code, (int, float)) and not isinstance(code, bool)
        else "Unknown"
    )

    temp = _num(current.get("temperature_2m"))
    feels = _num(current.get("apparent_temperature"))
    hum = _num(current.get("relative_humidity_2m"))
    wind = _num(current.get("wind_speed_10m"))

    def fmt_temp(value):
        if value is None:
            return ""
        return f"{round(value)}{temp_unit}"

    return {
        "location": name or "Local",
        "description": description,
        "temperature": fmt_temp(temp),
        "feelsLike": fmt_temp(feels),
        "humidity": f"{hum}%" if hum is not None else "",
        "wind": f"{round(wind)} {wind_unit}" if wind is not None else "",
        "sunrise": iso_to_hm(_first(daily.get("sunrise"))),
        "sunset": iso_to_hm(_first(daily.get("sunset"))),
        "high": fmt_temp(_num(_first(daily.get("temperature_2m_max")))),
        "low": fmt_temp(_num(_first(daily.get("temperature_2m_min")))),
    }


if __name__ == "__main__":
    main()
